OPENAI_API_KEY=your-api-key

# HMAC secret for signing the session cookie (src/modules/identity/service/cookie.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Local infrastructure (see docker-compose.yml)
DATABASE_URL=postgresql://cayamanan:cayamanan@localhost:5432/cayamanan
REDIS_URL=redis://localhost:6379

# Unprivileged app role — all runtime queries go through this, never DATABASE_URL.
APP_DATABASE_URL=postgresql://cayamanan_app:cayamanan_app@localhost:5432/cayamanan

# Dedicated test database — never point tests at the dev database.
TEST_DATABASE_URL=postgresql://cayamanan:cayamanan@localhost:5432/cayamanan_test
TEST_APP_DATABASE_URL=postgresql://cayamanan_app:cayamanan_app@localhost:5432/cayamanan_test
