OPENAI_API_KEY=your-api-key

# HMAC secret for signing the session cookie (src/modules/identity/service/cookie.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# AES-256-GCM key for encrypting secrets stored in system_settings (currently just an
# admin-configured OpenAI key — src/platform/secrets.ts, src/modules/system/actions/set-openai-key.ts).
# Must decode from base64 to exactly 32 bytes. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-key

# Local infrastructure (see docker-compose.yml)
DATABASE_URL=postgresql://cayamanan:cayamanan@localhost:5432/cayamanan
REDIS_URL=redis://localhost:6379

# Unprivileged app role — all runtime queries go through this, never DATABASE_URL.
APP_DATABASE_URL=postgresql://cayamanan_app:cayamanan_app@localhost:5432/cayamanan

# Dedicated test database — never point tests at the dev database.
TEST_DATABASE_URL=postgresql://cayamanan:cayamanan@localhost:5432/cayamanan_test
TEST_APP_DATABASE_URL=postgresql://cayamanan_app:cayamanan_app@localhost:5432/cayamanan_test

# Missy tool scoping. When a screen context is present, her toolset is narrowed to the
# current module plus an always-on core, with `catalog.find` to reach anything else.
#
# Currently set to `unscoped` deliberately. Measured at 30 tools: scoping /app/employees
# saves 1.1% of the schema payload (employees legitimately needs the org tools, which are
# 16 of the 30), while costing a two-turn handoff whenever Missy needs something
# off-module — catalog.find surfaces the tool, but it only becomes callable on the *next*
# message. That is a bad trade today. /app/settings already shows 83% savings, so the
# payoff arrives with the payroll/attendance/leave slices. Remove this line to enable.
MISSY_TOOL_SCOPING=unscoped
